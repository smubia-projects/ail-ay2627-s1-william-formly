# Formly API (Cloud Run). Copy to server/.env for local runs; upload as the DOTENV repo secret.

# Inference (OpenAI-compatible chat completions through the club gateway)
# gateway base URL
API_BASE_URL=https://api.apiyi.com/v1
# secret: the project's key from the AI Lodge key bot
API_KEY=
# model for filling forms, reading documents and learning
MODEL_NAME=deepseek-v4-1-flash-260910

# Browser origins allowed to call the API (comma-separated): the Vercel playground.
# The Chrome extension calls from its service worker and needs no entry here.
CORS_ORIGINS=http://localhost:5173

# Rate limits per IP (fallbacks; the central sheet overrides them). Unset Upstash = limiting off.
# "Fill with Formly" presses
RATE_LIMIT_FILL_MAX=5
# "Fill from my documents" presses
RATE_LIMIT_EXTRACT_MAX=3
# learning from answers typed before Submit
RATE_LIMIT_LEARN_MAX=5
RATE_LIMIT_WINDOW_SECONDS=432000
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN come from the batch's shared env.
